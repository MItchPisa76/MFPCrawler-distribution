<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <?ifdef JpIsSystemWide ?>
    <?define JpInstallScope="perMachine"?>
    <?else?>
    <?define JpInstallScope="perUser"?>
    <?endif?>
    <?define JpProductLanguage=1033 ?>
    <?define JpInstallerVersion=200 ?>
    <?define JpCompressedMsi=yes ?>
    <?include $(var.JpConfigDir)/overrides.wxi ?>
    
    <?ifdef JpAllowUpgrades ?>
    <?define JpUpgradeVersionOnlyDetectUpgrade="no"?>
    <?else?>
    <?define JpUpgradeVersionOnlyDetectUpgrade="yes"?>
    <?endif?>
    
    <?ifdef JpAllowDowngrades ?>
    <?define JpUpgradeVersionOnlyDetectDowngrade="no"?>
    <?else?>
    <?define JpUpgradeVersionOnlyDetectDowngrade="yes"?>
    <?endif?>
    
    <Product Id="$(var.JpProductCode)" Name="$(var.JpAppName)" Language="$(var.JpProductLanguage)" Version="$(var.JpAppVersion)" Manufacturer="$(var.JpAppVendor)" UpgradeCode="$(var.JpProductUpgradeCode)">
        <Package Description="$(var.JpAppDescription)" Manufacturer="$(var.JpAppVendor)" InstallerVersion="$(var.JpInstallerVersion)" Compressed="$(var.JpCompressedMsi)" InstallScope="$(var.JpInstallScope)" Platform="x64" />
        <Media Id="1" Cabinet="Data.cab" EmbedCab="yes" />
        
        <Upgrade Id="$(var.JpProductUpgradeCode)">
            <UpgradeVersion OnlyDetect="$(var.JpUpgradeVersionOnlyDetectUpgrade)" Property="JP_UPGRADABLE_FOUND" Maximum="$(var.JpAppVersion)" MigrateFeatures="yes" IncludeMaximum="$(var.JpUpgradeVersionOnlyDetectUpgrade)" />
            <UpgradeVersion OnlyDetect="$(var.JpUpgradeVersionOnlyDetectDowngrade)" Property="JP_DOWNGRADABLE_FOUND" Minimum="$(var.JpAppVersion)" MigrateFeatures="yes" IncludeMinimum="$(var.JpUpgradeVersionOnlyDetectDowngrade)" />
            <!-- Rileva qualsiasi versione di MFPCrawler già installata -->
            <UpgradeVersion OnlyDetect="yes" Property="MFPCRAWLER_EXISTING_FOUND" Minimum="0.0.0.0" IncludeMinimum="yes" />
        </Upgrade>

        <?ifndef JpAllowUpgrades ?>
        <CustomAction Id="JpDisallowUpgrade" Error="!(loc.DisallowUpgradeErrorMessage)" />
        <?endif?>
        <?ifndef JpAllowDowngrades ?>
        <CustomAction Id="JpDisallowDowngrade" Error="!(loc.DowngradeErrorMessage)" />
        <?endif?>
        
        <Binary Id="JpCaDll" SourceFile="wixhelper.dll" />
        <CustomAction Id="JpFindRelatedProducts" BinaryKey="JpCaDll" DllEntry="FindRelatedProductsEx" />
        
        <!-- Standard required root -->
        <Directory Id="TARGETDIR" Name="SourceDir" />
        
        <Feature Id="DefaultFeature" Title="!(loc.MainFeatureTitle)" Level="1">
            <ComponentGroupRef Id="Shortcuts" />
            <ComponentGroupRef Id="Files" />
            <ComponentGroupRef Id="FileAssociations" />
        </Feature>
        
        <CustomAction Id="JpSetARPINSTALLLOCATION" Property="ARPINSTALLLOCATION" Value="[INSTALLDIR]" />
        <CustomAction Id="JpSetARPCOMMENTS" Property="ARPCOMMENTS" Value="$(var.JpAppDescription)" />
        <CustomAction Id="JpSetARPCONTACT" Property="ARPCONTACT" Value="$(var.JpAppVendor)" />
        <CustomAction Id="JpSetARPSIZE" Property="ARPSIZE" Value="$(var.JpAppSizeKb)" />
         
        <!-- Proprietà per la versione esistente e i parametri Custom -->
        <Property Id="EXISTING_ACTION" Value="UPDATE" />
        <Property Id="NOME_REGISTRATO" Value="nome" />
        <Property Id="INFO_REGISTRAZIONE" Value="161" />
        <Property Id="PARAMETRO_SERVER" Value="myhist" />
        
        <!-- Custom Action per la disinstallazione -->
        <CustomAction Id="CA_UninstallPrevious" Directory="TARGETDIR" ExeCommand="msiexec /x [MFPCRAWLER_EXISTING_FOUND] /qb" Return="asyncWait" />

        <UIRef Id="JpUI" />
        
        <InstallExecuteSequence>
            <Custom Action="JpSetARPINSTALLLOCATION" After="CostFinalize">Not Installed</Custom>
            <Custom Action="JpSetARPCOMMENTS" After="CostFinalize">Not Installed</Custom>
            <Custom Action="JpSetARPCONTACT" After="CostFinalize">Not Installed</Custom>
            <Custom Action="JpSetARPSIZE" After="CostFinalize">Not Installed</Custom>
            <?ifndef JpAllowUpgrades ?>
            <Custom Action="JpDisallowUpgrade" After="JpFindRelatedProducts">JP_UPGRADABLE_FOUND</Custom>
            <?endif?>
            <?ifndef JpAllowDowngrades ?>
            <Custom Action="JpDisallowDowngrade" After="JpFindRelatedProducts">JP_DOWNGRADABLE_FOUND</Custom>
            <?endif?>
            <RemoveExistingProducts Before="CostInitialize" />
            <Custom Action="JpFindRelatedProducts" After="FindRelatedProducts" />
        </InstallExecuteSequence>
        
        <InstallUISequence>
            <Custom Action="JpFindRelatedProducts" After="FindRelatedProducts" />
        </InstallUISequence>

        <!-- Configurazione della sequenza dell'Interfaccia Utente -->
        <UI>
        <!-- Definizione dello stile mancante -->
    <TextStyle Id="WixUI_Font_Emphasized" FaceName="Tahoma" Size="8" Bold="yes" />

    <!-- 1. IMPOSTA WELCOMECUSTOMDLG COME PRIMO DIALOGO DELLA SEQUENZA UI -->
    <InstallUISequence>
        <Show Dialog="WelcomeCustomDlg" Before="ExecuteAction">NOT Installed</Show>
    </InstallUISequence>

    <!-- 2. GESTIONE DEL TASTO 'Back' IN InstallDirDlg -->
    <!-- (Se l'utente torna indietro dal dialogo di selezione cartella) -->
    <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeCustomDlg">NOT MFPCRAWLER_EXISTING_FOUND</Publish>
    <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="ExistingVersionDlg">MFPCRAWLER_EXISTING_FOUND</Publish>
    
    
    <!-- DIALOGO 1: WelcomeCustomDlg -->
    <Dialog Id="WelcomeCustomDlg" Width="370" Height="270" Title="!(loc.ShortcutPromptDlg_Title)">
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="WixUI_Bmp_Dialog" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        
        <Control Id="Title" Type="Text" X="135" Y="12" Width="220" Height="30" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Benvenuti nell'installazione di MFPCrawler" />

        <Control Id="RegisteredToLabel" Type="Text" X="135" Y="48" Width="220" Height="12" Transparent="yes" Text="{\WixUI_Font_Emphasized}Installazione dedicata per:" />
        <Control Id="RegisteredName" Type="Text" X="135" Y="62" Width="220" Height="12" Transparent="yes" Text="[NOME_REGISTRATO]" />
        <Control Id="RegisteredInfo" Type="Text" X="135" Y="76" Width="220" Height="25" Transparent="yes" Text="[INFO_REGISTRAZIONE]" />

        <Control Id="ServerLabel" Type="Text" X="135" Y="108" Width="220" Height="12" Transparent="yes" Text="{\WixUI_Font_Emphasized}Server di destinazione:" />
        <Control Id="ServerParam" Type="Text" X="135" Y="122" Width="220" Height="15" Transparent="yes" Text="[PARAMETRO_SERVER]" />

        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
            <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
    </Dialog>

    <!-- DIALOGO 2: ExistingVersionDlg -->
    <Dialog Id="ExistingVersionDlg" Width="370" Height="270" Title="!(loc.ShortcutPromptDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.ShortcutPromptDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Rilevata versione precedente" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Seleziona l'azione da eseguire per la versione esistente." />

        <!-- CONTROL: Solo la dichiarazione senza opzioni all'interno -->
        <Control Id="ActionRadioGroup" Type="RadioButtonGroup" X="30" Y="60" Width="300" Height="120" Property="EXISTING_ACTION" />

        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
            <Publish Event="DoAction" Value="CA_UninstallPrevious">EXISTING_ACTION = "UNINSTALL"</Publish>
            <Publish Event="EndDialog" Value="Exit">EXISTING_ACTION = "UNINSTALL"</Publish>
            <Publish Event="NewDialog" Value="InstallDirDlg">EXISTING_ACTION = "UPDATE" OR EXISTING_ACTION = "OVERWRITE"</Publish>
        </Control>

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
            <Publish Event="NewDialog" Value="WelcomeCustomDlg">1</Publish>
        </Control>

        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
            <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
    </Dialog>

    <!-- DEFINIZIONE RADIOBUTTON: Fuori dai Dialog, dentro <UI> -->
    <RadioButtonGroup Property="EXISTING_ACTION">
        <RadioButton Value="UPDATE" Text="Aggiorna la versione esistente (mantiene le configurazioni)" X="0" Y="0" Width="290" Height="25" />
        <RadioButton Value="OVERWRITE" Text="Sovrascrivi completamente (sostituisce tutti i file)" X="0" Y="30" Width="290" Height="25" />
        <RadioButton Value="UNINSTALL" Text="Disinstalla la versione precedente ed esci" X="0" Y="60" Width="290" Height="25" />
    </RadioButtonGroup>

    <!-- Flussi di navigazione tra i dialoghi -->
    <Publish Dialog="WelcomeCustomDlg" Control="Next" Event="NewDialog" Value="ExistingVersionDlg">MFPCRAWLER_EXISTING_FOUND</Publish>
    <Publish Dialog="WelcomeCustomDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg">NOT MFPCRAWLER_EXISTING_FOUND</Publish>

    <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeCustomDlg">NOT MFPCRAWLER_EXISTING_FOUND</Publish>
    <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="ExistingVersionDlg">MFPCRAWLER_EXISTING_FOUND</Publish>
</UI>
    </Product>
</Wix>
