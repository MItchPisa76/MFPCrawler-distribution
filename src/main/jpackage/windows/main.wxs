<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <?ifdef JpIsSystemWide ?>
    <?define JpInstallScope="perMachine"?>
    <?else?>
    <?define JpInstallScope="perUser"?>
    <?endif?>
    <?define JpProductLanguage=1033 ?>
    <?define JpInstallerVersion=200 ?>
    <?define JpCompressedMsi=yes ?>
    <?include $(var.JpConfigDir)/overrides.wxi ?>
    <?ifndef NomeRegistrato ?><?define NomeRegistrato="nome" ?><?endif?>
    <?ifndef InfoRegistrazione ?><?define InfoRegistrazione="161" ?><?endif?>
    <?ifndef ParametroServer ?><?define ParametroServer="myhist" ?><?endif?>
    
    <?ifdef JpAllowUpgrades ?>
    <?define JpUpgradeVersionOnlyDetectUpgrade="no"?>
    <?else?>
    <?define JpUpgradeVersionOnlyDetectUpgrade="yes"?>
    <?endif?>
    
    <?ifdef JpAllowDowngrades ?>
    <?define JpUpgradeVersionOnlyDetectDowngrade="no"?>
    <?else?>
    <?define JpUpgradeVersionOnlyDetectDowngrade="yes"?>
    <?endif?>
    
    <Product Id="$(var.JpProductCode)" Name="$(var.JpAppName)" Language="$(var.JpProductLanguage)" Version="$(var.JpAppVersion)" Manufacturer="$(var.JpAppVendor)" UpgradeCode="$(var.JpProductUpgradeCode)">
        <Package Description="$(var.JpAppDescription)" Manufacturer="$(var.JpAppVendor)" InstallerVersion="$(var.JpInstallerVersion)" Compressed="$(var.JpCompressedMsi)" InstallScope="$(var.JpInstallScope)" Platform="x64" />
        <Media Id="1" Cabinet="Data.cab" EmbedCab="yes" />
        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramMenuFolder" />
            <Directory Id="DesktopFolder" />
        </Directory>
        
        <Upgrade Id="$(var.JpProductUpgradeCode)">
            <UpgradeVersion OnlyDetect="$(var.JpUpgradeVersionOnlyDetectUpgrade)" Property="JP_UPGRADABLE_FOUND" Maximum="$(var.JpAppVersion)" MigrateFeatures="yes" IncludeMaximum="$(var.JpUpgradeVersionOnlyDetectUpgrade)" />
            <UpgradeVersion OnlyDetect="$(var.JpUpgradeVersionOnlyDetectDowngrade)" Property="JP_DOWNGRADABLE_FOUND" Minimum="$(var.JpAppVersion)" MigrateFeatures="yes" IncludeMinimum="$(var.JpUpgradeVersionOnlyDetectDowngrade)" />
            <!-- Rileva qualsiasi versione di MFPCrawler già installata -->
            <UpgradeVersion OnlyDetect="yes" Property="MFPCRAWLER_EXISTING_FOUND" Minimum="0.0.0.0" IncludeMinimum="yes" />
        </Upgrade>

        <?ifndef JpAllowUpgrades ?>
        <CustomAction Id="JpDisallowUpgrade" Error="!(loc.DisallowUpgradeErrorMessage)" />
        <?endif?>
        <?ifndef JpAllowDowngrades ?>
        <CustomAction Id="JpDisallowDowngrade" Error="!(loc.DowngradeErrorMessage)" />
        <?endif?>
        
        <Binary Id="JpCaDll" SourceFile="wixhelper.dll" />
        <CustomAction Id="JpFindRelatedProducts" BinaryKey="JpCaDll" DllEntry="FindRelatedProductsEx" />
        
        <!-- Collegamento alla cartella del Menu Start usando la struttura generata da jpackage -->
        <DirectoryRef Id="ProgramMenuFolder">
            <Directory Id="ApplicationProgramsFolder" Name="$(var.JpAppName)" />
        </DirectoryRef>

        <!-- Collegamenti / Icone nel Menu Start e Desktop -->
        <DirectoryRef Id="ApplicationProgramsFolder">
            <Component Id="ApplicationShortcut" Guid="*">
                <Condition>INSTALLSTARTMENUSHORTCUT = 1</Condition>
                <Shortcut Id="ApplicationStartMenuShortcut" Name="$(var.JpAppName)" Description="$(var.JpAppDescription)" Target="[INSTALLDIR]$(var.JpAppName).exe" WorkingDirectory="INSTALLDIR" />
                <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
                <RegistryValue Root="HKCU" Key="Software\$(var.JpAppVendor)\$(var.JpAppName)" Name="installed" Type="integer" Value="1" KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <DirectoryRef Id="DesktopFolder">
            <Component Id="ApplicationShortcutDesktop" Guid="*">
                <Condition>INSTALLDESKTOPSHORTCUT = 1</Condition>
                <Shortcut Id="ApplicationDesktopShortcut" Name="$(var.JpAppName)" Description="$(var.JpAppDescription)" Target="[INSTALLDIR]$(var.JpAppName).exe" WorkingDirectory="INSTALLDIR" />
                <RegistryValue Root="HKCU" Key="Software\$(var.JpAppVendor)\$(var.JpAppName)" Name="desktop_shortcut" Type="integer" Value="1" KeyPath="yes" />
            </Component>
        </DirectoryRef>
        
        <Feature Id="DefaultFeature" Title="!(loc.MainFeatureTitle)" Level="1">
            <ComponentGroupRef Id="Shortcuts" />
            <ComponentGroupRef Id="Files" />
            <ComponentGroupRef Id="FileAssociations" />
            <ComponentRef Id="ApplicationShortcut" />
            <ComponentRef Id="ApplicationShortcutDesktop" />
        </Feature>
        
        <CustomAction Id="JpSetARPINSTALLLOCATION" Property="ARPINSTALLLOCATION" Value="[INSTALLDIR]" />
        <CustomAction Id="JpSetARPCOMMENTS" Property="ARPCOMMENTS" Value="$(var.JpAppDescription)" />
        <CustomAction Id="JpSetARPCONTACT" Property="ARPCONTACT" Value="$(var.JpAppVendor)" />
        <CustomAction Id="JpSetARPSIZE" Property="ARPSIZE" Value="$(var.JpAppSizeKb)" />
         
        <!-- Proprietà per la versione esistente e i parametri Custom -->
        <Property Id="EXISTING_ACTION" Value="UPDATE" />
        <Property Id="NOME_REGISTRATO" Value="$(var.NomeRegistrato)" />
        <Property Id="INFO_REGISTRAZIONE" Value="$(var.InfoRegistrazione)" />
        <Property Id="PARAMETRO_SERVER" Value="$(var.ParametroServer)" />
        <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />
        <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" />
        <Property Id="INSTALLSTARTMENUSHORTCUT" Value="1" />
        
        <!-- Custom Action per la disinstallazione preventiva (Usa la proprietà MFPCRAWLER_EXISTING_FOUND) -->
        <CustomAction Id="CA_UninstallPrevious" Directory="TARGETDIR" ExeCommand="&quot;[SystemFolder]msiexec.exe&quot; /x [MFPCRAWLER_EXISTING_FOUND] /qb" Return="asyncNoWait" />

        <!-- Custom Action per avviare l'applicazione al termine dell'installazione -->
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Avvia $(var.JpAppName) adesso" />
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
        <Property Id="WixShellExecTarget" Value="[INSTALLDIR]$(var.JpAppName).exe" />
        <CustomAction Id="LaunchApplication" BinaryKey="WixCA" DllEntry="WixShellExec" Impersonate="yes" />

        <UIRef Id="WixUI_Common" />
        <UIRef Id="WixUI_ErrorProgressText" />
        
        <InstallExecuteSequence>
            <Custom Action="JpSetARPINSTALLLOCATION" After="CostFinalize">Not Installed</Custom>
            <Custom Action="JpSetARPCOMMENTS" After="CostFinalize">Not Installed</Custom>
            <Custom Action="JpSetARPCONTACT" After="CostFinalize">Not Installed</Custom>
            <Custom Action="JpSetARPSIZE" After="CostFinalize">Not Installed</Custom>
            <?ifndef JpAllowUpgrades ?>
            <Custom Action="JpDisallowUpgrade" After="JpFindRelatedProducts">JP_UPGRADABLE_FOUND</Custom>
            <?endif?>
            <?ifndef JpAllowDowngrades ?>
            <Custom Action="JpDisallowDowngrade" After="JpFindRelatedProducts">JP_DOWNGRADABLE_FOUND</Custom>
            <?endif?>
            <RemoveExistingProducts Before="CostInitialize" />
            <Custom Action="JpFindRelatedProducts" After="FindRelatedProducts" />
        </InstallExecuteSequence>

        <InstallUISequence>
            <Custom Action="JpFindRelatedProducts" After="FindRelatedProducts" />
            <Show Dialog="WelcomeCustomDlg" Before="ProgressDlg">NOT Installed OR (Installed AND NOT RESUME AND NOT Preselected AND NOT PATCH)</Show>
        </InstallUISequence>

        <!-- Configurazione personalizzata dell'Interfaccia Utente -->
        <UI>
            <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
            <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
            <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
            <TextStyle Id="MfpFont_Emphasized" FaceName="Tahoma" Size="8" Bold="yes" />

            <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed</Publish>

            <!-- Set di dialog proprio (sostituisce WixUI_InstallDir, senza WelcomeDlg/MaintenanceWelcomeDlg standard) -->
            <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
            <Property Id="WixUI_Mode" Value="InstallDir" />
            <Property Id="ARPNOMODIFY" Value="1" />

            <DialogRef Id="BrowseDlg" />
            <DialogRef Id="DiskCostDlg" />
            <DialogRef Id="ErrorDlg" />
            <DialogRef Id="FatalError" />
            <DialogRef Id="FilesInUse" />
            <DialogRef Id="MsiRMFilesInUse" />
            <DialogRef Id="PrepareDlg" />
            <DialogRef Id="ProgressDlg" />
            <DialogRef Id="ResumeDlg" />
            <DialogRef Id="UserExit" />
            <DialogRef Id="InvalidDirDlg" />
            <DialogRef Id="LicenseAgreementDlg" />
            <DialogRef Id="InstallDirDlg" />
            <DialogRef Id="VerifyReadyDlg" />
            <DialogRef Id="MaintenanceTypeDlg" />

            <Publish Dialog="BrowseDlg" Control="OK" Event="DoAction" Value="WixUIValidatePath" Order="3">1</Publish>
            <Publish Dialog="BrowseDlg" Control="OK" Event="SpawnDialog" Value="InvalidDirDlg" Order="4"><![CDATA[NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID<>"1"]]></Publish>

            <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999">1</Publish>

            <!-- Installazione: WelcomeCustomDlg -> [ExistingVersionDlg] -> License -> InstallDir -> MfpShortcutDlg -> VerifyReady -->
            <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeCustomDlg">1</Publish>
            <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg">LicenseAccepted = "1" AND NOT Installed</Publish>
            <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg">LicenseAccepted = "1" AND Installed</Publish>

            <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg">1</Publish>
            <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
            <Publish Dialog="InstallDirDlg" Control="Next" Event="DoAction" Value="WixUIValidatePath" Order="2">NOT WIXUI_DONTVALIDATEPATH</Publish>
            <Publish Dialog="InstallDirDlg" Control="Next" Event="SpawnDialog" Value="InvalidDirDlg" Order="3"><![CDATA[NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID<>"1"]]></Publish>
            <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="MfpShortcutDlg" Order="4">WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID="1"</Publish>
            <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
            <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2">1</Publish>

            <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MfpShortcutDlg" Order="1">NOT Installed</Publish>
            <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2">Installed</Publish>

            <!-- Manutenzione: WelcomeCustomDlg -> License -> MaintenanceTypeDlg (Ripara/Rimuovi) -->
            <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
            <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
            <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg">1</Publish>

            <!-- DIALOGO 1: WelcomeCustomDlg -->
            <Dialog Id="WelcomeCustomDlg" Width="370" Height="270" Title="[ProductName] Setup">
                <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="WixUI_Bmp_Dialog" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
                
                <Control Id="Title" Type="Text" X="135" Y="12" Width="220" Height="30" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Benvenuti nell'installazione di MFPCrawler" />

                <Control Id="RegisteredToLabel" Type="Text" X="135" Y="48" Width="220" Height="12" Transparent="yes" Text="{\MfpFont_Emphasized}Installazione dedicata per:" />
                <Control Id="RegisteredName" Type="Text" X="135" Y="62" Width="220" Height="12" Transparent="yes" Text="[NOME_REGISTRATO]" />
                <Control Id="RegisteredInfo" Type="Text" X="135" Y="76" Width="220" Height="25" Transparent="yes" Text="[INFO_REGISTRAZIONE]" />

                <Control Id="ServerLabel" Type="Text" X="135" Y="108" Width="220" Height="12" Transparent="yes" Text="{\MfpFont_Emphasized}Server di destinazione:" />
                <Control Id="ServerParam" Type="Text" X="135" Y="122" Width="220" Height="15" Transparent="yes" Text="[PARAMETRO_SERVER]" />

                <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
                    <Publish Event="NewDialog" Value="ExistingVersionDlg">NOT Installed AND MFPCRAWLER_EXISTING_FOUND</Publish>
                    <Publish Event="NewDialog" Value="LicenseAgreementDlg">Installed OR NOT MFPCRAWLER_EXISTING_FOUND</Publish>
                </Control>

                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
                    <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
                </Control>
            </Dialog>

            <!-- DIALOGO 2: ExistingVersionDlg -->
            <Dialog Id="ExistingVersionDlg" Width="370" Height="270" Title="[ProductName] Setup">
                <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
                <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

                <Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Rilevata versione precedente" />
                <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Seleziona l'azione da eseguire per la versione esistente." />

                <Control Id="ActionRadioGroup" Type="RadioButtonGroup" X="30" Y="60" Width="300" Height="120" Property="EXISTING_ACTION">
                    <RadioButtonGroup Property="EXISTING_ACTION">
                        <RadioButton Value="UPDATE" Text="Aggiorna la versione esistente (mantiene le configurazioni)" X="0" Y="0" Width="290" Height="25" />
                        <RadioButton Value="OVERWRITE" Text="Sovrascrivi completamente (sostituisce tutti i file)" X="0" Y="30" Width="290" Height="25" />
                        <RadioButton Value="UNINSTALL" Text="Disinstalla la versione precedente ed esci" X="0" Y="60" Width="290" Height="25" />
                    </RadioButtonGroup>
                </Control>

                <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
                    <Publish Event="DoAction" Value="CA_UninstallPrevious">EXISTING_ACTION = "UNINSTALL"</Publish>
                    <Publish Event="EndDialog" Value="Exit">EXISTING_ACTION = "UNINSTALL"</Publish>
                    <Publish Event="NewDialog" Value="LicenseAgreementDlg">EXISTING_ACTION = "UPDATE" OR EXISTING_ACTION = "OVERWRITE"</Publish>
                </Control>

                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
                    <Publish Event="NewDialog" Value="WelcomeCustomDlg">1</Publish>
                </Control>

                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
                    <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
                </Control>
            </Dialog>


            <!-- DIALOGO 3: MfpShortcutDlg -->
            <Dialog Id="MfpShortcutDlg" Width="370" Height="270" Title="[ProductName] Setup">
                <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
                <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

                <Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Collegamenti" />
                <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Scegli quali collegamenti creare." />

                <Control Id="StartMenuCheck" Type="CheckBox" X="30" Y="65" Width="300" Height="18" Property="INSTALLSTARTMENUSHORTCUT" CheckBoxValue="1" Text="Crea un collegamento nel menu Start" />
                <Control Id="DesktopCheck" Type="CheckBox" X="30" Y="90" Width="300" Height="18" Property="INSTALLDESKTOPSHORTCUT" CheckBoxValue="1" Text="Crea un collegamento sul Desktop" />

                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
                    <Publish Event="NewDialog" Value="InstallDirDlg">1</Publish>
                </Control>
                <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
                    <Publish Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
                    <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
                </Control>
            </Dialog>
        </UI>
    </Product>
</Wix>
