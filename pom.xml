<!-- properties -->
<properties>
  <maven.compiler.source>17</maven.compiler.source>
  <maven.compiler.target>17</maven.compiler.target>
  <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
</properties>

<!-- compiler plugin -->
<plugin>
  <groupId>org.apache.maven.plugins</groupId>
  <artifactId>maven-compiler-plugin</artifactId>
  <version>3.11.0</version>
  <configuration>
    <release>${maven.compiler.source}</release>
  </configuration>
</plugin>

<!-- jlink to create runtime image (output: target/image) -->
<plugin>
  <groupId>org.apache.maven.plugins</groupId>
  <artifactId>maven-jlink-plugin</artifactId>
  <version>3.2.0</version>
  <executions>
    <execution>
      <id>jlink-image</id>
      <goals><goal>jlink</goal></goals>
      <phase>package</phase>
      <configuration>
        <outputDirectory>${project.build.directory}/image</outputDirectory>
        <compress>2</compress>
        <stripDebug>true</stripDebug>
        <noHeaderFiles>true</noHeaderFiles>
        <noManPages>true</noManPages>
        <!-- launcher maps your module + main class to a launcher name -->
        <launchers>
          <launcher>
            <name>mfpcrawler</name>
            <module>your.module.name</module>
            <mainClass>mtc.MFPCrawler.MFPCrawler</mainClass>
          </launcher>
        </launchers>
      </configuration>
    </execution>
  </executions>
</plugin>

<!-- jpackage uses the generated image -->
<plugin>
  <groupId>org.panteleyev</groupId>
  <artifactId>jpackage-maven-plugin</artifactId>
  <version>1.6.0</version>
  <configuration>
    <name>MFPCrawler</name>
    <appVersion>${project.version}</appVersion>
    <vendor>Mitch Pisa</vendor>
    <mainClass>mtc.MFPCrawler.MFPCrawler</mainClass>
    <mainJar>your-module-jar-if-needed.jar</mainJar>
    <input>target</input>
    <destination>target/dist</destination>
    <type>exe</type>
    <icon>${project.basedir}/src/main/resources/icon.ico</icon>
    <runtimeImage>${project.build.directory}/image</runtimeImage>
    <javaOptions>
      <option>-Dfile.encoding=UTF-8</option>
    </javaOptions>
    <!-- windows installer settings -->
    <winMenu>true</winMenu>
    <winMenuGroup>MFPCrawler</winMenuGroup>
    <winShortcut>true</winShortcut>
    <winDirChooser>true</winDirChooser>
    <winPerUserInstall>false</winPerUserInstall>
    <winShortcutPrompt>true</winShortcutPrompt>
    <winConsole>false</winConsole>
  </configuration>
</plugin>
