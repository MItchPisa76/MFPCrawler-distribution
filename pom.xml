<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    
    <groupId>mtc.MFPCrawler</groupId>
    <artifactId>mfpcrawler</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    
    <name>MFPCrawler</name>
    <description>MFPCrawler Distribution</description>
    
    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    
    <build>
        <plugins>
            <!-- compiler plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>${maven.compiler.source}</release>
                </configuration>
            </plugin>
            
            <!-- jlink to create runtime image (output: target/image) -->
            <plugin>
    <groupId>org.apache.maven.plugins</groupId>
    <artifactId>maven-jlink-plugin</artifactId>
    <version>3.2.0</version>
    <executions>
        <execution>
            <id>jlink-image</id>
            <goals><goal>jlink</goal></goals>
            <phase>package</phase>
            <configuration>
                <skip>true</skip>  <!-- ADD THIS LINE -->
                <outputDirectory>image</outputDirectory>
                <!-- rest of config -->
            </configuration>
        </execution>
    </executions>
</plugin>
 
            <!-- jpackage uses the generated image -->
            <plugin>
                <groupId>org.panteleyev</groupId>
                <artifactId>jpackage-maven-plugin</artifactId>
                <version>1.6.0</version>
                <configuration>
                    <name>MFPCrawler</name>
                    <appVersion>${project.version}</appVersion>
                    <vendor>Mitch Pisa</vendor>
                    <mainClass>mtc.MFPCrawler.MFPCrawler</mainClass>
                    <mainJar>MFPCrawler-fat.jar</mainJar>
                    <input>target</input>
                    <destination>target/dist</destination>
                    <type>EXE</type>
                    <icon>src/main/resources/icon.ico</icon>
                   
                    <javaOptions>
                        <option>-Dfile.encoding=UTF-8</option>
                    </javaOptions>
                    <winMenu>true</winMenu>
                    <winMenuGroup>MFPCrawler</winMenuGroup>
                    <winShortcut>true</winShortcut>
                    <winDirChooser>true</winDirChooser>
                    <winPerUserInstall>false</winPerUserInstall>
                    <winShortcutPrompt>true</winShortcutPrompt>
                    <winConsole>false</winConsole>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
