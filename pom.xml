



<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>mtc.MFPCrawler</groupId>
    <artifactId>mfpcrawler</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>MFPCrawler</name>
    <description>MFPCrawler Distribution</description>
    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <plugins>
            <!-- Compiler plugin per Java 17 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>${maven.compiler.source}</release>
                </configuration>
            </plugin>

            <!-- jpackage plugin per la creazione dell'installer Windows .exe -->
           <plugin>
    <groupId>org.panteleyev</groupId>
    <artifactId>jpackage-maven-plugin</artifactId>
    <version>1.7.0</version>
    <configuration>
        <name>MFPCrawler</name>
        <appVersion>${project.version}</appVersion>
        <vendor>Mitch Pisa</vendor>
        <mainClass>mtc.MFPCrawler.MFPCrawler</mainClass>
        <mainJar>MFPCrawler-fat.jar</mainJar>
        <input>target</input>
        <destination>target/dist</destination>
        <type>EXE</type>
        <icon>src/main/resources/icon.ico</icon>

        <!-- Include l'ambiente Java -->
        <runtimeImage>${java.home}</runtimeImage>

        <!-- CHIAVE PER L'AGGIORNAMENTO AUTOMATICO -->
        <!-- Genera un GUID statico (es. da https://www.guidgenerator.com/) e NON cambiarlo mai tra le varie release -->
        <winUpgradeUuid>7833ab21-31fc-45df-86d2-e2b4be6a1324</winUpgradeUuid>

        <javaOptions>
            <option>-Dfile.encoding=UTF-8</option>
        </javaOptions>
        <winMenu>true</winMenu>
        <winMenuGroup>MFPCrawler</winMenuGroup>
        <winShortcut>true</winShortcut>
        <winDirChooser>true</winDirChooser>
        <winPerUserInstall>false</winPerUserInstall>
        <winShortcutPrompt>true</winShortcutPrompt>
        <winConsole>false</winConsole>
    </configuration>
</plugin>
        </plugins>
    </build>
</project>
